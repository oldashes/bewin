DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Base64-encoded PEM CA for providers such as Aiven. Leave empty when the provider uses a public CA.
DB_SSL_CA_BASE64=""
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=10000
DB_APPLICATION_NAME="bewin"
CRON_SECRET="replace-with-a-long-random-string"
SYNC_LOOKBACK_DAYS=60
SYNC_MAX_STOCKS=160
THS_HOT_CATEGORIES="stock,concept,industry"
THS_WATCHLIST_MAX=80
THS_WATCHLIST_LOOKBACK_DAYS=60
SIGNAL_MAX_UNIVERSE=240
IFIND_FEATURE_FETCH_MISSING_KLINE_MAX=80
EASTMONEY_KLINE_FETCH_TIMEOUT_MS=6000
TENCENT_KLINE_FETCH_TIMEOUT_MS=10000
KLINE_PROVIDER_MAX_LAG_DAYS=7
# Optional paid tertiary fallback. Tencent K-line fallback does not require this.
IFIND_KLINE_FALLBACK_ENABLED=false
IFIND_REFRESH_TOKEN=""

# Local migration commands only. Never add these values to Git or Vercel.
# MIGRATION_SOURCE_DATABASE_URL may be omitted to reuse DATABASE_URL.
MIGRATION_SOURCE_DATABASE_URL=""
MIGRATION_TARGET_DATABASE_URL=""
MIGRATION_SOURCE_SSL_CA_BASE64=""
MIGRATION_TARGET_SSL_CA_BASE64=""

SIGNAL_FETCH_MISSING_KLINE_MAX=120
DAILY_KLINE_SHARD_SIZE=80
QUOTE_FALLBACK_MAX=120
