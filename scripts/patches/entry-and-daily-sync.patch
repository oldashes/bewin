+function applyCurrentRanksToHistories(historiesByCode, topRanks, targetDate) {
+  const date = normalizeDate(targetDate);
+  if (!date || !historiesByCode) return historiesByCode;
+  for (const item of topRanks || []) {
+    const code = String(item.code || "").match(/\d{6}/)?.[0] || "";
+    const rank = n(item.rank);
+    if (!code || !Number.isFinite(rank)) continue;
+    historiesByCode.set(
+      code,
+      mergeRankHistory(historiesByCode.get(code), [{ date, rank, raw: { currentList: true } }]),
+    );
+  }
+  return historiesByCode;
+}
