+function displayMarketPrefix(code) {
+  const clean = String(code || "").match(/\d{6}/)?.[0] || "";
+  if (!clean) return "SZ";
+  if (/^(?:4|8|92)/.test(clean)) return "BJ";
+  if (clean.startsWith("6")) return "SH";
+  return "SZ";
+}
+
+function displayEmCode(code) {
+  const clean = String(code || "").match(/\d{6}/)?.[0] || "";
+  return clean ? `${displayMarketPrefix(clean)}${clean}` : "";
+}
+
+function normalizePositionEntry(entry) {
+  const raw = entry == null || String(entry).trim() === "" ? "nextOpen" : String(entry).trim();
+  const compact = raw.replace(/[-_\s]/g, "").toLowerCase();
+  if (compact === "nextopen") return "nextOpen";
+  if (compact === "close" || compact === "sameclose") return "close";
+  if (compact === "open" || compact === "sameopen") return "open";
+  return "nextOpen";
+}
+
+function cleanStockCodes(codes) {
+  return [...new Set((codes || []).map((code) => {
+    try {
+      return normalizeStock(code).code;
+    } catch {
+      return String(code || "").match(/\d{6}/)?.[0] || "";
+    }
+  }).filter(Boolean))];
+}
